NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# server-only — nunca prefixar com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Provedor de rotas (distancia/tempo de carro e tracado de rua).
# "ors" (padrao) = OpenRouteService, chave gratuita em openrouteservice.org
# (2.500 requisicoes/dia, cobre Directions e Matrix). server-only.
# "osrm" = OSRM proprio via OSRM_BASE_URL — o destino no servidor interno.
# Sem provedor o sistema continua de pe: cai pra distancia em linha reta.
ROTAS_PROVEDOR=ors
ORS_API_KEY=

# So usado quando ROTAS_PROVEDOR=osrm. Vazio aponta pro servidor publico de
# demonstracao, que e 1 req/s e PROIBIDO em producao pela politica deles —
# serve para teste, nao para operacao real.
OSRM_BASE_URL=

# Tiles do mapa (Leaflet). Vazio usa o OpenStreetMap padrao, que nao tem SLA
# e pede atribuicao visivel. Ponto unico de troca por CARTO/MapTiler/proprio.
NEXT_PUBLIC_TILES_URL=
NEXT_PUBLIC_TILES_ATRIBUICAO=

# TomTicket API v2.0 — responder chamado direto do sistema (migration 0028).
# server-only — nunca prefixar com NEXT_PUBLIC_ (token no front é token público).
# Gerado em Configurações > API no TomTicket; exige plano Premium ou Enterprise.
# Sem ele o app roda normalmente, só o botão de responder fica indisponível.
TOMTICKET_TOKEN=

# TomTicket: departamento que a coleta le (default MANUTENCAO - SRT).
TOMTICKET_DEPARTAMENTO=

# Segredo pro agendador chamar POST /api/tomticket/sync sem sessao de usuario.
SYNC_SECRET=

# Envia o horario de trabalho (start_date/end_date) junto da resposta no
# TomTicket. Desligado: a API recusa o par mesmo quando valido (ver comentario
# em janelaDeTrabalho). "1" religa.
TOMTICKET_ENVIAR_HORARIO=

# Atendente que assume o chamado no TomTicket ao responder ("CSM - SRT").
# Vazio = nao vincula ninguem. Achar o id em /v2.0/department/operator/list.
TOMTICKET_OPERADOR_ID=

# Intervalo da sincronizacao automatica, em minutos (0 desliga).
# Vale pro processo longo (dev/VPS). Em serverless, use o Vercel Cron.
SYNC_INTERVALO_MINUTOS=
